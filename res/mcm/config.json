    {
      "pageDisplayName": "Perks",
      "content": [
        {
          "text": "Vanilla perks",
          "type": "section"
        },
        {
          "id": "iPerkMode:Perks",
          "text": "Perks",
          "type": "dropdown",
          "help": "Bonus: everything works, perks make it better. Unlock: same bonuses, plus air control needs Agility 5, bunnyhop needs Moving Target 1, ABH needs Moving Target 3.",
          "valueOptions": {
            "options": [
              "Off",
              "Bonus",
              "Unlock"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "iPerkMessages:Perks",
          "text": "On-screen notes",
          "type": "dropdown",
          "help": "Shows that your perks are picked up. On rank up: a note when a perk rank gives you something. Also after loading: one line listing the perks in use.",
          "valueOptions": {
            "options": [
              "Off",
              "On rank up",
              "Also after loading"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "Moving Target: faster sprint (+4% per rank).",
          "type": "text"
        },
        {
          "text": "Strong Back: weight slows you less (20% per rank).",
          "type": "text"
        },
        {
          "text": "Adamantium Skeleton: softer landing tilt.",
          "type": "text"
        },
        {
          "text": "Aquaboy / Aquagirl: no water drag.",
          "type": "text"
        },
        {
          "text": "Sneak: quieter Half-Life steps while sneaking.",
          "type": "text"
        },
        {
          "text": "Agility: better air control.",
          "type": "text"
        },
        {
          "text": "Action Boy / Action Girl: wider bunnyhop window; max rank unlocks auto-jump (hold jump, keyboard or gamepad).",
          "type": "text"
        },
        {
          "text": "Perks are found by their ID, so other languages and perk mods that change the vanilla perks work.",
          "type": "text"
        }
      ]
    },
    {
      "pageDisplayName": "Debug",
      "content": [
        {
          "text": "Debug",
          "type": "section"
        },
        {
          "id": "bDebugLog:General",
          "text": "Debug log",
          "type": "switcher",
          "help": "Troubleshooting only: writes test info to Documents\\My Games\\Fallout4\\F4SE\\BHOP.log.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bRecord:General",
          "text": "Record movement",
          "type": "switcher",
          "help": "For tuning: each time you close the pause menu with this on, the next seconds of movement are written to Documents\\My Games\\Fallout4\\F4SE\\BHOP_record.csv. Send it with BHOP.log. Off for normal play.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fRecordSeconds:General",
          "text": "Recording length (seconds)",
          "type": "slider",
          "help": "How long each recording lasts.",
          "valueOptions": {
            "min": 5,
            "max": 60,
            "step": 5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Reset to defaults: delete Data\\MCM\\Settings\\BHOP.ini and restart the game.",
          "type": "text"
        }
      ]
    }
  ]
