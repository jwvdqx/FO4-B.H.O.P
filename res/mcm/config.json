{
  "modName": "BHOP",
  "displayName": "B.H.O.P.",
  "minMcmVersion": 2,
  "content": [
    {
      "text": "Boston Hopping Overhaul Project",
      "type": "section"
    },
    {
      "text": "Half-Life 1 and 2 player movement, camera and sounds.",
      "type": "text"
    },
    {
      "text": " ",
      "type": "text"
    },
    {
      "text": "General: master switch, profile, mode, input and speeds.",
      "type": "text"
    },
    {
      "text": "Movement: grip, surfaces and weight.",
      "type": "text"
    },
    {
      "text": "Air & Bunnyhop: air strafing and bunnyhopping.",
      "type": "text"
    },
    {
      "text": "Camera: view bob, strafe roll, landing tilt.",
      "type": "text"
    },
    {
      "text": "Sounds: footstep details and volume.",
      "type": "text"
    },
    {
      "text": "Perks: how vanilla perks join in.",
      "type": "text"
    },
    {
      "text": " ",
      "type": "text"
    },
    {
      "text": "Changes apply when you close the menu.",
      "type": "text"
    }
  ],
  "pages": [
    {
      "pageDisplayName": "General",
      "content": [
        {
          "text": "Master switch",
          "type": "section"
        },
        {
          "id": "bEnabled:General",
          "text": "B.H.O.P. enabled",
          "type": "switcher",
          "help": "Off = plain Fallout 4: no Half-Life movement, camera or sounds. Your settings are kept.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Profile",
          "type": "section"
        },
        {
          "id": "iProfile:General",
          "text": "Profile",
          "type": "dropdown",
          "help": "My settings: everything you set in this menu, saved as you change it. The other three are ready-made and never change your settings: pick My settings again to get yours back. Full Half-Life 1 / 2: the original game with no helpers (its speeds, its jump, exact timing, no perks). Claude's choice: Half-Life 2 feel tuned for Fallout and gamepads.",
          "valueOptions": {
            "options": [
              "My settings",
              "Full Half-Life 1",
              "Full Half-Life 2",
              "Claude's choice"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "With a ready-made profile, the options below show your own settings; they are saved but only used with My settings.",
          "type": "text"
        },
        {
          "text": "Mode",
          "type": "section"
        },
        {
          "id": "iMode:General",
          "text": "Movement",
          "type": "dropdown",
          "help": "Vanilla Fallout 4, Half-Life 1 or Half-Life 2 movement for the player.",
          "valueOptions": {
            "options": [
              "Vanilla",
              "Half-Life 1",
              "Half-Life 2"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "bHalfLifeSounds:Sounds",
          "text": "Half-Life sounds",
          "type": "switcher",
          "help": "Half-Life footsteps, jump and landing sounds for the player.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iSoundSet:Sounds",
          "text": "Sound set",
          "type": "dropdown",
          "help": "Follow movement: HL1 mode uses HL1 sounds, HL2 mode uses HL2 sounds. Or always use one set (also works with Vanilla movement).",
          "valueOptions": {
            "options": [
              "Follow movement",
              "Half-Life 1",
              "Half-Life 2"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "Feel",
          "type": "section"
        },
        {
          "id": "iSmoothing:General",
          "text": "Smoothness",
          "type": "dropdown",
          "help": "Every frame (recommended): every frame is split into Half-Life-sized steps done right away, so you get Half-Life's results at any frame rate with no delay. Exact tick: can feel steppy at 40-60 fps. Exact tick + smoothing: smooth, up to one tick of delay.",
          "valueOptions": {
            "options": [
              "Exact tick",
              "Exact tick + smoothing",
              "Every frame"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "bDirectInput:General",
          "text": "Direct stick input",
          "type": "switcher",
          "help": "Reads the stick directly instead of waiting for Fallout's own speed-up and slow-down. Much less input delay. First person only.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iSpeedMode:General",
          "text": "Speeds",
          "type": "dropdown",
          "help": "Fallout's own walk/run/sprint speeds, or Half-Life's (HL2: walk 150, run 190, sprint 320; HL1: run 320).",
          "valueOptions": {
            "options": [
              "Fallout",
              "Half-Life"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "iHL1Sprint:General",
          "text": "Sprint in Half-Life 1",
          "type": "dropdown",
          "help": "With Half-Life speeds in HL1 mode: Half-Life 1 has no sprint. Choose whether the sprint key still makes you faster.",
          "valueOptions": {
            "options": [
              "Does nothing",
              "Faster"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fBaseSpeedCap:General",
          "text": "Base speed cap",
          "type": "slider",
          "help": "Your base walk/run/sprint speed never goes above this (Half-Life units per second; Fallout's run is about 210, sprint 280). Buffs, chems, Power Armor and perks apply after the cap. 0 = no cap.",
          "valueOptions": {
            "min": 0,
            "max": 600,
            "step": 5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "bEnableInPowerArmor:General",
          "text": "Half-Life movement in Power Armor",
          "type": "switcher",
          "help": "Off: Power Armor moves like vanilla.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bWallClip:General",
          "text": "Walls take your speed",
          "type": "switcher",
          "help": "Walls, NPCs and doors take away the part of your speed that goes into them, and you slide along the rest, like in Half-Life.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bWallProbe:General",
          "text": "Check wall surfaces (experiment)",
          "type": "switcher",
          "help": "When you hit a wall, the mod checks the real wall surface to get its exact direction, for cleaner wall slides. Off: it uses the guess from how you moved.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fSlopeAngle:General",
          "text": "Half-Life slopes up to (degrees)",
          "type": "slider",
          "help": "On slopes up to this steep you keep your heading and speed and simply climb, like Half-Life, instead of being pushed sideways and slowed when you cross a slope at an angle. Both Half-Life games use about 45. 0 = off (Fallout's slopes).",
          "valueOptions": {
            "min": 0,
            "max": 60,
            "step": 1,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "iSwimMode:General",
          "text": "Swimming",
          "type": "dropdown",
          "help": "Half-Life: swim speed, momentum and water friction like Half-Life (you keep your speed when you land in water, then the water slows you). Fallout still handles floating and diving. Fallout: the game's own swimming.",
          "valueOptions": {
            "options": [
              "Fallout",
              "Half-Life"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "bWaterSurf:General",
          "text": "Water surfing",
          "type": "switcher",
          "help": "Hold jump at the water's surface while moving faster than you can swim (after a bunnyhop, a jump or a slide into water) and you skim along keeping your speed, like Half-Life. You can air strafe while surfing. Needs Half-Life swimming.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bPushes:Air",
          "text": "Pushes keep momentum",
          "type": "switcher",
          "help": "Hits, explosions and scripted pushes add to your momentum, Half-Life style, then friction slows them.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Movement",
      "content": [
        {
          "text": "Grip",
          "type": "section"
        },
        {
          "id": "fResponsiveness:Ground",
          "text": "Responsiveness",
          "type": "slider",
          "help": "Multiplies friction and acceleration. 1.0 = exact Half-Life. The default 1.3 is a B.H.O.P. preset: snappier and less sliding at Fallout's speeds.",
          "valueOptions": {
            "min": 0.5,
            "max": 3,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Surfaces",
          "type": "section"
        },
        {
          "id": "bSurfaceFriction:Ground",
          "text": "Surface grip",
          "type": "switcher",
          "help": "Surfaces change grip like in Source: ice slides, mud and snow drag, water slows you.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fSurfaceFrictionStrength:Ground",
          "text": "Surface grip strength",
          "type": "slider",
          "help": "0 = no effect, 1 = full effect.",
          "valueOptions": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Ledge edges",
          "type": "section"
        },
        {
          "id": "iEdgeFriction:Ground",
          "text": "Edge friction",
          "type": "dropdown",
          "help": "Half-Life 1: friction doubles when there's no floor just ahead, so you stop at ledges instead of sliding off. HL2 removed it.",
          "valueOptions": {
            "options": [
              "Off",
              "Half-Life 1 mode only",
              "Both modes"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fEdgeFrictionMult:Ground",
          "text": "Edge friction strength",
          "type": "slider",
          "help": "Friction multiplier at ledges. Half-Life 1: 2.",
          "valueOptions": {
            "min": 1,
            "max": 5,
            "step": 0.25,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Custom ground values",
          "type": "section"
        },
        {
          "id": "bCustomGround:Ground",
          "text": "Use custom values",
          "type": "switcher",
          "help": "Off: the selected game's own values (friction 4, accelerate 10, stop speed 100).",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fFriction:Ground",
          "text": "Friction",
          "type": "slider",
          "help": "How quickly you slow down when you let go. Half-Life: 4.",
          "valueOptions": {
            "min": 0.5,
            "max": 12,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fAccelerate:Ground",
          "text": "Acceleration",
          "type": "slider",
          "help": "How quickly you reach full speed. Half-Life: 10.",
          "valueOptions": {
            "min": 1,
            "max": 30,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fStopSpeed:Ground",
          "text": "Stop speed",
          "type": "slider",
          "help": "Below this speed you come to a stop faster. Half-Life: 100.",
          "valueOptions": {
            "min": 0,
            "max": 300,
            "step": 5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Weight",
          "type": "section"
        },
        {
          "id": "bCarryWeightAffectsMovement:Weight",
          "text": "Carry weight affects movement",
          "type": "switcher",
          "help": "The fuller your inventory, the slower you start and turn.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fFullLoadAccelMult:Weight",
          "text": "Acceleration at full load",
          "type": "slider",
          "help": "1.0 = no change, 0.5 = half.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fOverencumberedAccelMult:Weight",
          "text": "Acceleration when over-encumbered",
          "type": "slider",
          "help": "1.0 = no change.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fFullLoadFrictionMult:Weight",
          "text": "Friction at full load",
          "type": "slider",
          "help": "Lower = slide more when stopping. 1.0 = no change.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fPowerArmorAccelMult:Weight",
          "text": "Power Armor acceleration",
          "type": "slider",
          "help": "Extra multiplier in Power Armor.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fPowerArmorFrictionMult:Weight",
          "text": "Power Armor friction",
          "type": "slider",
          "help": "Extra multiplier in Power Armor.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Air & Bunnyhop",
      "content": [
        {
          "text": "Air",
          "type": "section"
        },
        {
          "id": "bAirControl:Air",
          "text": "Half-Life air control",
          "type": "switcher",
          "help": "Momentum is kept in the air and you can air strafe: hold left or right and turn the same way.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fAirAccelerate:Air",
          "text": "Air acceleration",
          "type": "slider",
          "help": "How much air strafing can steer and gain. Half-Life: 10.",
          "valueOptions": {
            "min": 1,
            "max": 30,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fStrafeAssist:Air",
          "text": "Strafe assist (for sticks)",
          "type": "slider",
          "help": "When you strafe and turn the same way, aims the strafe at the best angle. 0 = pure Half-Life, 1 = full help.",
          "valueOptions": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Bunnyhop",
          "type": "section"
        },
        {
          "id": "bBunnyhop:Air",
          "text": "Bunnyhop",
          "type": "switcher",
          "help": "Jump again right after landing and friction doesn't slow you down.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fBhopGrace:Air",
          "text": "Bunnyhop timing window",
          "type": "slider",
          "help": "Seconds after landing before friction starts. Original games: one frame (0.015 s). Default 0.05 is a little more forgiving. Action Boy/Girl adds 0.025 s per rank.",
          "valueOptions": {
            "min": 0,
            "max": 0.3,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "iAutoJump:Air",
          "text": "Auto-jump",
          "type": "dropdown",
          "help": "Hold jump to keep bunnyhopping. With perk: unlocked by Action Boy/Action Girl at max rank.",
          "valueOptions": {
            "options": [
              "Off",
              "With perk",
              "Always"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fJumpBuffer:Air",
          "text": "Jump buffer",
          "type": "slider",
          "help": "Press jump up to this many seconds before you land and you jump the moment you touch down. Makes bunnyhop timing much easier on a gamepad. 0 = off (original timing).",
          "valueOptions": {
            "min": 0,
            "max": 0.3,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fLedgeJump:Air",
          "text": "Ledge jump",
          "type": "slider",
          "help": "Seconds after running off an edge during which you can still jump. Also saves jumps pressed on stairs and bumps. Not in Power Armor. 0 = off.",
          "valueOptions": {
            "min": 0,
            "max": 0.3,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "bHL1BhopCap:Air",
          "text": "HL1 bunnyhop speed cap",
          "type": "switcher",
          "help": "Half-Life 1 mode: jumping above 1.7x max speed cuts your speed, like HL1.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bHL2JumpBoost:Air",
          "text": "HL2 jump boost",
          "type": "switcher",
          "help": "Half-Life 2 mode: the small forward speed boost when you jump.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bHL2ABH:Air",
          "text": "HL2 back-hopping (ABH)",
          "type": "switcher",
          "help": "Half-Life 2 mode: keep the jump boost's famous backwards quirk.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iHL2AirFriction:Air",
          "text": "HL2 rising air control",
          "type": "dropdown",
          "help": "Half-Life 2: while you rise slowly (under 140 units/s), air acceleration is quartered, as in Source. Scaled: the 140 is scaled to Fallout's own jump speed.",
          "valueOptions": {
            "options": [
              "Off",
              "Exact",
              "Scaled to Fallout's jump"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "iJumpPhysics:Air",
          "text": "Jumping and gravity",
          "type": "dropdown",
          "help": "Fallout: Fallout's own jump and fall. HL gravity: Half-Life's stronger gravity with Fallout's jump height (same height, quicker jump). Exact Half-Life: HL1 jumps 45 units high, HL2 only 21 (duck-jump onto things). Falls use it too, so fall damage may change.",
          "valueOptions": {
            "options": [
              "Fallout",
              "HL gravity, Fallout height",
              "Exact Half-Life"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "Crouch-jump",
          "type": "section"
        },
        {
          "id": "bCrouchJump:Air",
          "text": "Crouch-jump",
          "type": "switcher",
          "help": "Press sneak in the air to lift your feet like Half-Life's duck-jump. Works while rising and just after the top, once per jump.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iCrouchJumpKey:Air",
          "text": "Crouch-jump with",
          "type": "dropdown",
          "help": "Sneak: press sneak in the air. Sneak or jump: pressing jump again while you're still going up works too (easier on a gamepad; you don't land sneaking). Not in Power Armor.",
          "valueOptions": {
            "options": [
              "Sneak",
              "Sneak or jump again"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "iCrouchJumpHeight:Air",
          "text": "Crouch-jump height",
          "type": "dropdown",
          "help": "Exact per game: HL1 +18 units (0.46 m), HL2 +36 units (0.91 m). Scaled: the same share of Fallout's own jump height.",
          "valueOptions": {
            "options": [
              "Exact per game",
              "Scaled to Fallout's jump"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fCrouchJumpWindow:Air",
          "text": "Window after the top",
          "type": "slider",
          "help": "Seconds after the top of the jump that crouch-jump still works.",
          "valueOptions": {
            "min": 0,
            "max": 0.5,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "bCrouchLandSneak:Air",
          "text": "Land sneaking",
          "type": "switcher",
          "help": "After a crouch-jump you land sneaking, like Half-Life keeps you ducked.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Camera",
      "content": [
        {
          "text": "View bob",
          "type": "section"
        },
        {
          "id": "iViewBob:Camera",
          "text": "View bob",
          "type": "dropdown",
          "help": "Half-Life 1's up-and-down camera bob while moving. Like the game: on in HL1 mode, off in HL2 mode.",
          "valueOptions": {
            "options": [
              "Off",
              "Like the game",
              "Always on"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fBobScale:Camera",
          "text": "Bob strength",
          "type": "slider",
          "help": "1.0 = Half-Life 1.",
          "valueOptions": {
            "min": 0,
            "max": 3,
            "step": 0.1,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Strafe roll",
          "type": "section"
        },
        {
          "id": "iViewRoll:Camera",
          "text": "Strafe roll",
          "type": "dropdown",
          "help": "The camera tilts a little when you strafe, like Half-Life 1. Like the game: on in HL1 mode, off in HL2 mode.",
          "valueOptions": {
            "options": [
              "Off",
              "Like the game",
              "Always on"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fRollAngle:Camera",
          "text": "Roll angle",
          "type": "slider",
          "help": "Degrees. Half-Life 1: 2.",
          "valueOptions": {
            "min": 0,
            "max": 8,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fRollSpeed:Camera",
          "text": "Full roll at speed",
          "type": "slider",
          "help": "Strafe speed (HL units/s) for the full angle. Half-Life 1: 200.",
          "valueOptions": {
            "min": 50,
            "max": 400,
            "step": 10,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Landing",
          "type": "section"
        },
        {
          "id": "bLandingPunch:Camera",
          "text": "Landing tilt",
          "type": "switcher",
          "help": "The camera tilts on hard landings, like Half-Life.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fPunchScale:Camera",
          "text": "Landing tilt strength",
          "type": "slider",
          "help": "1.0 = Half-Life.",
          "valueOptions": {
            "min": 0,
            "max": 3,
            "step": 0.1,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "iFalloutCameraMotion:Camera",
          "text": "Fallout's camera shake",
          "type": "dropdown",
          "help": "Fallout moves the first person camera with its animations: the dip and shake when you jump and land, the sprint sway. Off for jumps: removed while jumping and landing, so only Half-Life's landing tilt is left. Always off: no Fallout camera movement at all (also melee and other animations).",
          "valueOptions": {
            "options": [
              "Keep",
              "Off for jumps",
              "Always off"
            ],
            "sourceType": "ModSettingInt"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Sounds",
      "content": [
        {
          "text": "Footsteps",
          "type": "section"
        },
