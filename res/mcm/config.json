{
  "modName": "BHOP",
  "displayName": "B.H.O.P.",
  "minMcmVersion": 2,
  "content": [
    {
      "text": "Boston Hopping Overhaul Project",
      "type": "section"
    },
    {
      "text": "Half-Life 1 and 2 player movement, camera and sounds.",
      "type": "text"
    },
    {
      "text": " ",
      "type": "text"
    },
    {
      "text": "General: mode, sounds, smoothness, input and speeds.",
      "type": "text"
    },
    {
      "text": "Movement: grip, surfaces and weight.",
      "type": "text"
    },
    {
      "text": "Air & Bunnyhop: air strafing and bunnyhopping.",
      "type": "text"
    },
    {
      "text": "Camera: view bob, strafe roll, landing tilt.",
      "type": "text"
    },
    {
      "text": "Sounds: footstep details and volume.",
      "type": "text"
    },
    {
      "text": "Perks: how vanilla perks join in.",
      "type": "text"
    },
    {
      "text": " ",
      "type": "text"
    },
    {
      "text": "Changes apply when you close the menu.",
      "type": "text"
    }
  ],
  "pages": [
    {
      "pageDisplayName": "General",
      "content": [
        {
          "text": "Mode",
          "type": "section"
        },
        {
          "id": "iMode:General",
          "text": "Movement",
          "type": "dropdown",
          "help": "Vanilla Fallout 4, Half-Life 1 or Half-Life 2 movement for the player.",
          "valueOptions": {
            "options": [
              "Vanilla",
              "Half-Life 1",
              "Half-Life 2"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "bHalfLifeSounds:Sounds",
          "text": "Half-Life sounds",
          "type": "switcher",
          "help": "Half-Life footsteps, jump and landing sounds for the player.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iSoundSet:Sounds",
          "text": "Sound set",
          "type": "dropdown",
          "help": "Follow movement: HL1 mode uses HL1 sounds, HL2 mode uses HL2 sounds. Or always use one set (also works with Vanilla movement).",
          "valueOptions": {
            "options": [
              "Follow movement",
              "Half-Life 1",
              "Half-Life 2"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "Feel",
          "type": "section"
        },
        {
          "id": "iSmoothing:General",
          "text": "Smoothness",
          "type": "dropdown",
          "help": "Every frame: smoothest, no delay (recommended). Exact tick: Half-Life's tick rate (ground movement only), can feel steppy at 40-60 fps. Exact tick + smoothing: smooth, up to one tick of delay.",
          "valueOptions": {
            "options": [
              "Exact tick",
              "Exact tick + smoothing",
              "Every frame"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "bDirectInput:General",
          "text": "Direct stick input",
          "type": "switcher",
          "help": "Reads the stick directly instead of waiting for Fallout's own speed-up and slow-down. Much less input delay. First person only.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "iSpeedMode:General",
          "text": "Speeds",
          "type": "dropdown",
          "help": "Fallout's own walk/run/sprint speeds, or Half-Life's (HL2: walk 150, run 190, sprint 320; HL1: run 320).",
          "valueOptions": {
            "options": [
              "Fallout",
              "Half-Life"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "iHL1Sprint:General",
          "text": "Sprint in Half-Life 1",
          "type": "dropdown",
          "help": "With Half-Life speeds in HL1 mode: Half-Life 1 has no sprint. Choose whether the sprint key still makes you faster.",
          "valueOptions": {
            "options": [
              "Does nothing",
              "Faster"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "bEnableInPowerArmor:General",
          "text": "Half-Life movement in Power Armor",
          "type": "switcher",
          "help": "Off: Power Armor moves like vanilla.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bWallClip:General",
          "text": "Walls take your speed",
          "type": "switcher",
          "help": "Walls, NPCs and doors take away the part of your speed that goes into them, and you slide along the rest, like in Half-Life.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bPushes:Air",
          "text": "Pushes keep momentum",
          "type": "switcher",
          "help": "Hits, explosions and scripted pushes add to your momentum, Half-Life style, then friction slows them.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Movement",
      "content": [
        {
          "text": "Grip",
          "type": "section"
        },
        {
          "id": "fResponsiveness:Ground",
          "text": "Responsiveness",
          "type": "slider",
          "help": "Multiplies friction and acceleration. 1.0 = exact Half-Life. The default 1.3 is a B.H.O.P. preset: snappier and less sliding at Fallout's speeds.",
          "valueOptions": {
            "min": 0.5,
            "max": 3,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Surfaces",
          "type": "section"
        },
        {
          "id": "bSurfaceFriction:Ground",
          "text": "Surface grip",
          "type": "switcher",
          "help": "Surfaces change grip like in Source: ice slides, mud and snow drag, water slows you.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fSurfaceFrictionStrength:Ground",
          "text": "Surface grip strength",
          "type": "slider",
          "help": "0 = no effect, 1 = full effect.",
          "valueOptions": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Custom ground values",
          "type": "section"
        },
        {
          "id": "bCustomGround:Ground",
          "text": "Use custom values",
          "type": "switcher",
          "help": "Off: the selected game's own values (friction 4, accelerate 10, stop speed 100).",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fFriction:Ground",
          "text": "Friction",
          "type": "slider",
          "help": "How quickly you slow down when you let go. Half-Life: 4.",
          "valueOptions": {
            "min": 0.5,
            "max": 12,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fAccelerate:Ground",
          "text": "Acceleration",
          "type": "slider",
          "help": "How quickly you reach full speed. Half-Life: 10.",
          "valueOptions": {
            "min": 1,
            "max": 30,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fStopSpeed:Ground",
          "text": "Stop speed",
          "type": "slider",
          "help": "Below this speed you come to a stop faster. Half-Life: 100.",
          "valueOptions": {
            "min": 0,
            "max": 300,
            "step": 5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Weight",
          "type": "section"
        },
        {
          "id": "bCarryWeightAffectsMovement:Weight",
          "text": "Carry weight affects movement",
          "type": "switcher",
          "help": "The fuller your inventory, the slower you start and turn.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fFullLoadAccelMult:Weight",
          "text": "Acceleration at full load",
          "type": "slider",
          "help": "1.0 = no change, 0.5 = half.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fOverencumberedAccelMult:Weight",
          "text": "Acceleration when over-encumbered",
          "type": "slider",
          "help": "1.0 = no change.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fFullLoadFrictionMult:Weight",
          "text": "Friction at full load",
          "type": "slider",
          "help": "Lower = slide more when stopping. 1.0 = no change.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fPowerArmorAccelMult:Weight",
          "text": "Power Armor acceleration",
          "type": "slider",
          "help": "Extra multiplier in Power Armor.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fPowerArmorFrictionMult:Weight",
          "text": "Power Armor friction",
          "type": "slider",
          "help": "Extra multiplier in Power Armor.",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Air & Bunnyhop",
      "content": [
        {
          "text": "Air",
          "type": "section"
        },
        {
          "id": "bAirControl:Air",
          "text": "Half-Life air control",
          "type": "switcher",
          "help": "Momentum is kept in the air and you can air strafe: hold left or right and turn the same way.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fAirAccelerate:Air",
          "text": "Air acceleration",
          "type": "slider",
          "help": "How much air strafing can steer and gain. Half-Life: 10.",
          "valueOptions": {
            "min": 1,
            "max": 30,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fStrafeAssist:Air",
          "text": "Strafe assist (for sticks)",
          "type": "slider",
          "help": "When you strafe and turn the same way, aims the strafe at the best angle. 0 = pure Half-Life, 1 = full help.",
          "valueOptions": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Bunnyhop",
          "type": "section"
        },
        {
          "id": "bBunnyhop:Air",
          "text": "Bunnyhop",
          "type": "switcher",
          "help": "Jump again right after landing and friction doesn't slow you down.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fBhopGrace:Air",
          "text": "Bunnyhop timing window",
          "type": "slider",
          "help": "Seconds after landing before friction starts. Original games: one frame (0.015 s). Default 0.05 is a little more forgiving. Action Boy/Girl adds 0.025 s per rank.",
          "valueOptions": {
            "min": 0,
            "max": 0.3,
            "step": 0.01,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "iAutoJump:Air",
          "text": "Auto-jump",
          "type": "dropdown",
          "help": "Hold jump to keep bunnyhopping. With perk: unlocked by Action Boy/Action Girl at max rank.",
          "valueOptions": {
            "options": [
              "Off",
              "With perk",
              "Always"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "bHL1BhopCap:Air",
          "text": "HL1 bunnyhop speed cap",
          "type": "switcher",
          "help": "Half-Life 1 mode: jumping above 1.7x max speed cuts your speed, like HL1.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bHL2JumpBoost:Air",
          "text": "HL2 jump boost",
          "type": "switcher",
          "help": "Half-Life 2 mode: the small forward speed boost when you jump.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bHL2ABH:Air",
          "text": "HL2 back-hopping (ABH)",
          "type": "switcher",
          "help": "Half-Life 2 mode: keep the jump boost's famous backwards quirk.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Camera",
      "content": [
        {
          "text": "View bob",
          "type": "section"
        },
        {
          "id": "iViewBob:Camera",
          "text": "View bob",
          "type": "dropdown",
          "help": "Half-Life 1's up-and-down camera bob while moving. Like the game: on in HL1 mode, off in HL2 mode.",
          "valueOptions": {
            "options": [
              "Off",
              "Like the game",
              "Always on"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fBobScale:Camera",
          "text": "Bob strength",
          "type": "slider",
          "help": "1.0 = Half-Life 1.",
          "valueOptions": {
            "min": 0,
            "max": 3,
            "step": 0.1,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Strafe roll",
          "type": "section"
        },
        {
          "id": "iViewRoll:Camera",
          "text": "Strafe roll",
          "type": "dropdown",
          "help": "The camera tilts a little when you strafe, like Half-Life 1. Like the game: on in HL1 mode, off in HL2 mode.",
          "valueOptions": {
            "options": [
              "Off",
              "Like the game",
              "Always on"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "id": "fRollAngle:Camera",
          "text": "Roll angle",
          "type": "slider",
          "help": "Degrees. Half-Life 1: 2.",
          "valueOptions": {
            "min": 0,
            "max": 8,
            "step": 0.5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fRollSpeed:Camera",
          "text": "Full roll at speed",
          "type": "slider",
          "help": "Strafe speed (HL units/s) for the full angle. Half-Life 1: 200.",
          "valueOptions": {
            "min": 50,
            "max": 400,
            "step": 10,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Landing",
          "type": "section"
        },
        {
          "id": "bLandingPunch:Camera",
          "text": "Landing tilt",
          "type": "switcher",
          "help": "The camera tilts on hard landings, like Half-Life.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "fPunchScale:Camera",
          "text": "Landing tilt strength",
          "type": "slider",
          "help": "1.0 = Half-Life.",
          "valueOptions": {
            "min": 0,
            "max": 3,
            "step": 0.1,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Sounds",
      "content": [
        {
          "text": "Footsteps",
          "type": "section"
        },
        {
          "id": "bMuteVanillaPlayerFootsteps:Sounds",
          "text": "Mute vanilla player footsteps",
          "type": "switcher",
          "help": "Only the player's. NPC footsteps are never touched.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bJumpLandSounds:Sounds",
          "text": "Jump and landing sounds",
          "type": "switcher",
          "help": "Floor sound when you jump and land, like Half-Life.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bWaterSounds:Sounds",
          "text": "Shallow water sounds",
          "type": "switcher",
          "help": "Slosh and wade sounds in shallow water.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bSwimSounds:Sounds",
          "text": "Swim sounds",
          "type": "switcher",
          "help": "Half-Life swim sounds. Fallout already has its own.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bPowerArmorHardboot:Sounds",
          "text": "Power Armor boots (HL2)",
          "type": "switcher",
          "help": "Half-Life 2 set only: Power Armor steps use the Combine boot sounds.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bHL1FallPainSound:Sounds",
          "text": "Fall pain sound (HL1)",
          "type": "switcher",
          "help": "Half-Life 1 set only: pl_fallpain3 on a hard fall.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "id": "bUseVanillaReverb:Sounds",
          "text": "Use footstep reverb",
          "type": "switcher",
          "help": "Same reverb and distance as vanilla footsteps (including reverb mods). Turn off if sounds misbehave.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Volume",
          "type": "section"
        },
        {
          "id": "fVolume:Sounds",
          "text": "Volume",
          "type": "slider",
          "help": "All Half-Life sounds. 1.0 = as loud as Half-Life plays them.",
          "valueOptions": {
            "min": 0,
            "max": 2,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fRunVolume:Sounds",
          "text": "Running step volume",
          "type": "slider",
          "help": "Half-Life: 0.5",
          "valueOptions": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fWalkVolume:Sounds",
          "text": "Walking step volume",
          "type": "slider",
          "help": "Half-Life: 0.2",
          "valueOptions": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fSneakVolumeMult:Sounds",
          "text": "Extra sneaking volume",
          "type": "slider",
          "help": "Half-Life already makes ducking steps quieter (HL1 35%, HL2 65%). This multiplies on top. 1.0 = like Half-Life.",
          "valueOptions": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "text": "Timing",
          "type": "section"
        },
        {
          "id": "fRunStepSpeed:Sounds",
          "text": "Running steps from speed",
          "type": "slider",
          "help": "Speed (HL units/s) where steps switch to running. 0 = automatic: Half-Life's own thresholds scaled to your speeds.",
          "valueOptions": {
            "min": 0,
            "max": 320,
            "step": 5,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fRunStepInterval:Sounds",
          "text": "Running step time",
          "type": "slider",
          "help": "Seconds between steps. Half-Life: 0.3",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        },
        {
          "id": "fWalkStepInterval:Sounds",
          "text": "Walking step time",
          "type": "slider",
          "help": "Seconds between steps. Half-Life: 0.4",
          "valueOptions": {
            "min": 0.1,
            "max": 1,
            "step": 0.05,
            "sourceType": "ModSettingFloat"
          }
        }
      ]
    },
    {
      "pageDisplayName": "Perks",
      "content": [
        {
          "text": "Vanilla perks",
          "type": "section"
        },
        {
          "id": "iPerkMode:Perks",
          "text": "Perks",
          "type": "dropdown",
          "help": "Bonus: everything works, perks make it better. Unlock: same bonuses, plus air control needs Agility 5, bunnyhop needs Moving Target 1, ABH needs Moving Target 3.",
          "valueOptions": {
            "options": [
              "Off",
              "Bonus",
              "Unlock"
            ],
            "sourceType": "ModSettingInt"
          }
        },
        {
          "text": "Moving Target: faster sprint (+4% per rank).",
          "type": "text"
        },
        {
          "text": "Strong Back: weight slows you less (20% per rank).",
          "type": "text"
        },
        {
          "text": "Adamantium Skeleton: softer landing tilt.",
          "type": "text"
        },
        {
          "text": "Aquaboy / Aquagirl: no water drag.",
          "type": "text"
        },
        {
          "text": "Sneak: quieter Half-Life steps while sneaking.",
          "type": "text"
        },
        {
          "text": "Agility: better air control.",
          "type": "text"
        },
        {
          "text": "Action Boy / Action Girl: wider bunnyhop window; max rank unlocks auto-jump.",
          "type": "text"
        }
      ]
    },
    {
      "pageDisplayName": "Debug",
      "content": [
        {
          "text": "Debug",
          "type": "section"
        },
        {
          "id": "bDebugLog:General",
          "text": "Debug log",
          "type": "switcher",
          "help": "Troubleshooting only: writes test info to Documents\\My Games\\Fallout4\\F4SE\\BHOP.log.",
          "valueOptions": {
            "sourceType": "ModSettingBool"
          }
        },
        {
          "text": "Reset to defaults: delete Data\\MCM\\Settings\\BHOP.ini and restart the game.",
          "type": "text"
        }
      ]
    }
  ]
}